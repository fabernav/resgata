# Banco de dados.
#
# Desenvolvimento local (SQLite — e so um arquivo, nao precisa de servidor):
DATABASE_URL="file:./dev.db"
#
# Producao / publicado na Vercel (PostgreSQL — ver DEPLOY.md):
# DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# Segredo usado para assinar os tokens de sessao (JWT). Gere um valor forte com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-este-valor-por-uma-string-aleatoria-longa"

# Pontuacao minima para o Motor de Match gerar um Match (ver src/lib/matching.ts)
MATCH_MIN_SCORE=50

# Numero maximo de tentativas na verificacao de posse (protecao contra forca bruta)
MAX_VERIFICATION_ATTEMPTS=3

# Senhas erradas seguidas no login antes de travar aquele e-mail por 1 minuto
LOGIN_MAX_ATTEMPTS=5

# Endereco publico do site, usado no link de "esqueci minha senha".
# Local: http://localhost:3000 | Publicado: https://seu-app.vercel.app
APP_URL="http://localhost:3000"

# Envio de e-mail (esqueci minha senha). Sem nenhum dos dois abaixo, o
# e-mail aparece no terminal do `npm run dev` em vez de ser enviado.
#
# Opcao 1 (recomendada): Resend, envia por HTTPS e nao e bloqueado pela rede.
# Crie a chave em https://resend.com/api-keys. Sem dominio proprio verificado,
# so entrega no e-mail com que voce criou a conta no Resend.
RESEND_API_KEY=""
# RESEND_FROM="Resgata <nao-responda@seu-dominio.com>"  (so com dominio verificado)
#
# Opcao 2: SMTP. Algumas redes (faculdade, roteadores) bloqueiam este envio.
# Gmail: ative a verificacao em 2 etapas e crie uma "senha de app" em
# https://myaccount.google.com/apppasswords (use ela no SMTP_PASS).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="senha-de-app-de-16-letras"
EMAIL_FROM="Resgata <seu-email@gmail.com>"
