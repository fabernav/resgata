# Banco de dados.
#
# Desenvolvimento local (SQLite — e so um arquivo, nao precisa de servidor):
DATABASE_URL="file:./dev.db"
#
# Producao / publicado na Vercel (PostgreSQL — ver DEPLOY.md):
# DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# Segredo usado para assinar os tokens de sessao (JWT). Gere um valor forte com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-este-valor-por-uma-string-aleatoria-longa"

# Pontuacao minima para o Motor de Match gerar um Match (ver src/lib/matching.ts)
MATCH_MIN_SCORE=50

# Numero maximo de tentativas na verificacao de posse (protecao contra forca bruta)
MAX_VERIFICATION_ATTEMPTS=3
